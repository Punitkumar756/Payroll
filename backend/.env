PORT=5000
NODE_ENV=development

# MySQL connection (change to match your MySQL setup)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hrms
DB_USER=root
DB_PASSWORD=Punit@12

# JWT secrets (use strong random strings in production)
JWT_SECRET=hrms-jwt-secret-ankit-infotech-2026-change-me
JWT_REFRESH_SECRET=hrms-refresh-secret-ankit-infotech-2026-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES encryption key for PII fields (must be exactly 32 bytes in prod)
AES_KEY=hrms-aes-key-32bytes-2026-change

# File storage base path (for payslip PDFs, employee photos)
STORAGE_PATH=./uploads

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
